mixin external-link(href)
  a(href=href target='_blank' rel='noopener noreferrer')&attributes(attributes)
    block

mixin icon(id, title)
  svg.icon(width='24' height='24' fill='currentColor')&attributes(attributes)
    title=title
    use(href=`/icons.svg#${id}-icon`)

mixin input-field(label, options)
  - const name = moduleImports.toCamelCase(label)

  label.input-field&attributes(attributes) #{label}!{' '}
    if options.type === 'textarea'
      textarea(name=name)&attributes(options)
    else
      input(name=name)&attributes(options)
