extends layout

include mixins

block content
  include navbar

  main
    style.
      @scope {}

    form(action="/new" method="post")
      h2 Post your message
      +input-field(
        'Username:', {type: 'text', placeholder:'John Doe', required: true}
      )
      +input-field('Message:', {type: 'textarea', required: true})
      button(type="submit") Post

    section
      h2 Messages
      ul.messages
        - for (const { user, date, text } of messages)
          li.message
            h3=user
            time(date) Posted on #{date}.
            p=text

  include footer
