<!doctype html>
<html lang="en">

<%- include('partials/head', { title }) %>

<body>
  <div id="root">
    <a href="/">Go back</a>
    <form action="/new-message" method="post">
      <h1>Message draft</h1>
      <label class="field">
        <span class="label">Username (from 3 to 10 characters): </span>
        <input type="text" name="username" minlength="3" maxlength="10" placeholder="john_doe123" pattern="([0-9A-Za-z_]{1,20})|John Doe" required autocomplete="on">
      </label>
      <label class="field">
        <span class="label">Message (up to 1000 characters): </span>
        <textarea name="message" minlength="1" maxlength="1000" required></textarea>
      </label>
      <button type="submit">Post</button>
    </form>
  </div>
</body>

</html>
