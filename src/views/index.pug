extends layout

include /mixins/input-field

block content
  include layouts/navbar

  main
    form(action='/new', method='post')
      h2 Send your message

      +input-field('Username', { type: 'text', required: true })
      +input-field('Messages', { type: 'textarea', required: true })

      button(type='submit') Post

    section
      h2 Messages

      ul.messages
      - for (const { username, content, date } of messages)
        li.message
          h3= username
          time(datetime=date) Posted on #{ date }
          p= content

  include layouts/footer
