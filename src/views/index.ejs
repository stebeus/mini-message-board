<!doctype html>
<html lang="en">

<%- include('partials/head', { title }) %>

<body>
  <div id="root">
    <h1>Mini Message Board</h1>
    <ul class="messages">
      <% messages.forEach(({username, message, timestamp}) => { %>
      <li class="message">
        <h3><%= username %> </h3>
        <time datetime="<%= timestamp %>"><%= timestamp %></time>
        <p><%= message %> </p>
      </li>
      <% }); %>
    </ul>
  </div>
</body>

</html>
